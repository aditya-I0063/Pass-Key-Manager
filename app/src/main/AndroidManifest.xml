<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!--
        INTERNET is declared explicitly rather than being merged in silently. The app itself
        makes no network calls, but Firebase Analytics/Crashlytics/Performance and the Play
        in-app-update library all require it, and hiding that in a library manifest is how the
        README and privacy policy came to claim the app needs no internet permission.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".PasskeyApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PassKey">
        <activity
            android:name=".presentation.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.PassKey">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Autofill. BIND_AUTOFILL_SERVICE is held by the system, not requested by the app: it
            is what guarantees only the framework can bind to this service.
        -->
        <service
            android:name=".presentation.autofill.PasskeyAutofillService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service" />

            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
        </service>

        <!--
            Launched by the framework from the autofill suggestion list when the vault is locked.
            Not exported: only the PendingIntent the service hands out can start it.
        -->
        <activity
            android:name=".presentation.autofill.AutofillUnlockActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.PassKey" />

        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>

</manifest>