<?xml version="1.0" encoding="utf-8"?>
<!--
    android:allowBackup is "false", so nothing here is consulted today. These rules are kept
    correct anyway so that flipping the flag back on cannot silently start uploading the vault.

    The SQLCipher database must never leave the device through platform backup: users move their
    data with the app's own password-protected encrypted export instead.
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="root" path="." />
</full-backup-content>
